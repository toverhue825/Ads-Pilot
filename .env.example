# Copy to .env and fill in. Never commit .env.

# --- App ---
PORT=3000
BASE_URL=http://localhost:3000          # public URL once hosted, used in email links
APP_SECRET=change-me-to-a-long-random-string
DASHBOARD_PASSWORD=change-me            # shared team password for the dashboard

# --- Data source: "sample" (fake data for testing) or "meta" (live Facebook ads) ---
DATA_SOURCE=sample
META_ACCESS_TOKEN=                      # System User token from Business Manager (ads_read, ads_management)
META_AD_ACCOUNT_IDS=                    # one or more, comma-separated: act_111,act_222
META_API_VERSION=v23.0
META_LEAD_ACTIONS=lead,onsite_conversion.lead_grouped,offsite_conversion.fb_pixel_lead   # what counts as a lead; see npm run check-meta

# --- AI insights (Claude) ---
ANTHROPIC_API_KEY=                      # from console.anthropic.com; leave empty to keep AI insights off
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium                        # low | medium | high: how hard Claude thinks (higher = slower, costs more)
AI_WEEKLY_DAY=1                         # day the weekly review is written and emailed (0=Sun, 1=Mon …)

# --- Google (see README → Google setup) ---
GOOGLE_SERVICE_ACCOUNT_JSON=            # whole JSON key file contents, for the Drive content library
GOOGLE_DRIVE_FOLDER_ID=                 # from drive.google.com/drive/folders/<ID>
GOOGLE_OAUTH_CLIENT_ID=                 # for Google Business Profile sign-in
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=             # Manager account → Admin → API Center
GOOGLE_ADS_CUSTOMER_IDS=                # ad account ID(s), e.g. 123-456-7890
GOOGLE_ADS_LOGIN_CUSTOMER_ID=           # the Manager account's ID

# --- Goals & guardrails ---
TARGET_CPL=45                           # target cost per lead, in dollars
MAX_BUDGET_CHANGE_PCT=20                # largest budget move one suggestion can make
DAILY_SPEND_CAP=600                     # total daily budget across campaigns will never be raised above this
MIN_SPEND_TO_JUDGE=60                   # don't judge a campaign until it has spent this much in the window

# --- Schedule ---
SYNC_INTERVAL_MINUTES=60
DIGEST_HOUR=8                           # local hour to send the daily suggestions email

# --- Email (any SMTP provider: Google Workspace, Microsoft 365, SendGrid, Resend, etc.) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Ads Pilot <ads@example.com>
EMAIL_TO=you@example.com                # comma-separated list of approvers
